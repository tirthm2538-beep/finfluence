# Environment configuration for FinFluence FastAPI backend

# Allowed Frontend Origins for CORS (comma-separated, optional)
# Leave blank to automatically allow localhost and any *.vercel.app domain
CORS_ORIGINS=https://finfluence.vercel.app

# Optional AI Generation keys (only if generating cards dynamically with AI)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
