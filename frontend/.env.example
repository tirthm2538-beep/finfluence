# ==============================================================================
# FinFluence Production Environment Variables
# These must be configured in Vercel (Project Settings > Environment Variables)
# ==============================================================================

# 1. Supabase Project URL
# Found in: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://mxgiaxpotbcjnwhiypsr.supabase.co

# 2. Supabase Anon / Public API Key
# Found in: Supabase Dashboard > Project Settings > API > Project API Keys > "anon" / "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# 3. Live FastAPI Backend API URL
# Your live Render backend web service URL (without trailing slash)
NEXT_PUBLIC_API_URL=https://finfluence-d420.onrender.com
